{
  "name": "mocr-service",
  "version": "1.0.0",
  "description": "Motion Optical Character Recognition Service - Professional video text extraction and analysis",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/api/server.ts",
    "start": "node dist/api/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docs": "typedoc src --out docs",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "mocr",
    "motion-ocr",
    "video-analysis",
    "optical-character-recognition",
    "video-text-extraction",
    "asr",
    "speech-recognition",
    "video-processing",
    "ffmpeg",
    "tesseract"
  ],
  "author": "Devon Woodson",
  "license": "MIT",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "helmet": "^7.1.0",
    "image-size": "^1.1.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "tesseract.js": "^4.1.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devonwoodson/MOCR-Service.git"
  },
  "bugs": {
    "url": "https://github.com/devonwoodson/MOCR-Service/issues"
  },
  "homepage": "https://github.com/devonwoodson/MOCR-Service#readme"
}
