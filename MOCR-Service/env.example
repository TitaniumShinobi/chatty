# MOCR Service Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MOCR Processing Configuration
MOCR_MAX_FRAMES=50
MOCR_FRAME_INTERVAL=2
MOCR_FRAME_QUALITY=5

# OCR Configuration
MOCR_OCR_LANGUAGE=eng
MOCR_OCR_MIN_CONFIDENCE=30
MOCR_OCR_TIMEOUT=30000

# ASR Configuration
MOCR_ASR_LANGUAGE=en
MOCR_ASR_MODEL=base
MOCR_ASR_TIMEOUT=60000

# File Processing Configuration
MOCR_MAX_FILE_SIZE=104857600
MOCR_PROCESSING_TIMEOUT=300000

# Caching Configuration
MOCR_ENABLE_CACHING=true
MOCR_CACHE_EXPIRY=3600

# Analysis Features
MOCR_ENABLE_TEMPORAL_ANALYSIS=true
MOCR_ENABLE_SCENE_DETECTION=true
MOCR_ENABLE_TEXT_TRACKING=true
MOCR_ENABLE_SYNCHRONIZATION=true
MOCR_ENABLE_CONTENT_SUMMARIZATION=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined

# Database Configuration (if using persistent storage)
DATABASE_URL=sqlite:./mocr.db

# Redis Configuration (if using Redis for caching)
REDIS_URL=redis://localhost:6379

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# Security Configuration
API_KEY_REQUIRED=false
API_KEY_HEADER=X-API-Key
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
