# =============================================================================
# Ollama systemd service
# Location: /etc/systemd/system/ollama.service
#
# Setup:
#   sudo cp deploy/ollama.service /etc/systemd/system/ollama.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable ollama
#   sudo systemctl start ollama
#
# Logs:
#   sudo journalctl -u ollama -f
#
# Models will be loaded on-demand.
#
# 1 GB public proof hosts must use the tiny Chatty profile instead of routing
# live traffic to the canonical Three I seat models:
#   ollama pull qwen2.5:0.5b
#   set CHATTY_OLLAMA_PROFILE=tiny in the Chatty service env
#
# To pre-load canonical Lin seat models on a suitably sized host:
#   sudo systemctl stop ollama
#   ollama pull phi4-mini:latest
#   ollama pull mistral-small3.2:24b
#   ollama pull qwen3-coder:30b
#   sudo systemctl start ollama
# =============================================================================

[Unit]
Description=Ollama AI Model Server
After=network.target

[Service]
Type=simple
User=vvault
Group=vvault
WorkingDirectory=/home/vvault

Environment="OLLAMA_HOST=0.0.0.0:11434"
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"

ExecStart=/usr/local/bin/ollama serve

Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ollama

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
