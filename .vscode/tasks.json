{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dev",
            "command": "pnpm",
            "args": ["dev"],
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "custom",
                    "pattern": {
                        "regexp": "."
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "VITE .* ready",
                        "endsPattern": "ready"
                    }
                }
            ]
        },
        {
            "label": "test",
            "command": "pnpm",
            "args": ["test"],
            "problemMatcher": []
        },
        {
            "label": "build",
            "command": "pnpm",
            "args": ["build"],
            "problemMatcher": []
        }
    ]
}