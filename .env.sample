# copy this to .env and fill in real values

# Backend server
PORT=5000
FRONTEND_URL=http://localhost:5173

# Feature gates — toggle non-MVP systems
# ENABLE_FINANCE=true          # Finance dashboard + FXShinobi trading
# ENABLE_FAMILY=true           # Family controls / parental management
# ENABLE_TELEPHONY=true        # Twilio telephony integration
# ENABLE_MOCR=true             # MOCR document processing proxy
# ENABLE_DIAGNOSTICS=true      # Admin diagnostics endpoints
# ENABLE_MASTER_SCRIPTS=true   # Master scripts admin routes
# ENABLE_SCRIPTS=true          # Script execution admin routes

# VVAULT Configuration
VVAULT_RUNTIME_PATH=/path/to/vvault/runtimes
CHAT_CAPSULE_PATH=/path/to/vvault/capsules

# API keys
#OPENAI_API_KEY=sk-...
#OTHER_SECRET=xxx
