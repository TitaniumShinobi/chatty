#!/usr/bin/env bash
# Wrapper script that launches the development environment in the background
# so that Click/agents can invoke it with a simple `run chatty` command and
# immediately regain control of the chat.

set -euo pipefail

# Change to the repo root (script is installed in scripts/ so go up one level)
cd "$(dirname "$0")/.." || exit 1

# Start the keep-running supervisor in background so runtime recovers from crashes.
./scripts/keep-running.sh "$@" &
supervisor_pid=$!

sleep 1

if ! kill -0 "$supervisor_pid" 2>/dev/null; then
  echo "chatty failed to start; check /tmp/chatty-vite.log and /tmp/chatty-server.log" >&2
  wait "$supervisor_pid"
  exit 1
fi

# Provide immediate feedback
echo "chatty started (PID $supervisor_pid)"

disown  # detach from shell
