# Server Configuration
PORT=5000
NODE_ENV=development

# Comma-separated identifiers allowed to create/publish/forge protected canonical constructs.
# Defaults include Devon's local development identifiers; production should set this explicitly.
CHATTY_CANONICAL_OWNER_IDENTIFIERS=

# Database
MONGODB_URI=mongodb://localhost:27017/chatty

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (for verification emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret
# Optional shared @auth service for local Chatty sign-in.
# Use the same local auth process VVAULT points at when you want a shared dev login surface:
#   AUTH_PORT=1111 AUTH_APP_CONFIG_PATH=../auth/config/vvault.json AUTH_SESSION_SECRET=... npm run start --prefix ../auth
# `./bin/chatty` / `npm run runtime:up` now supervise the sibling `../auth` and `../vvault`
# processes by default in local dev so the shared bridge stays stable.
# AUTH_API_BASE_URL=http://127.0.0.1:1111
# AUTH_COOKIE_NAME=auth_sid
# VVAULT browser routes only trust shared auth; Chatty sid remains for non-VVAULT routes.
# Provider feature flags (Google is controlled by GOOGLE_CLIENT_* presence)
AUTH_APPLE_ENABLED=false
AUTH_GITHUB_ENABLED=false

# Chatty/VVault legal docs + consent tracking
VVAULT_LEGAL_BASE_URL=http://localhost:3000
LEGAL_VERSION_CHATTY_TERMS=2026-03-13
LEGAL_VERSION_CHATTY_PRIVACY=2026-03-13
LEGAL_VERSION_CHATTY_EECCD=2026-03-13
LEGAL_VERSION_VVAULT_TERMS=2026-03-13
LEGAL_VERSION_VVAULT_PRIVACY=2026-03-13
LEGAL_VERSION_VVAULT_EECCD=2026-03-13

# Turnstile (required for signup when NODE_ENV=production)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Backup Configuration
BACKUP_INTERVAL=0 0 2 * * *
BACKUP_PATH=./backups

# TTS Configuration (OpenVoice-first)
# Options: openvoice | elevenlabs
TTS_PROVIDER=openvoice
# Canonical Nova voice id/name used by your selected provider
TTS_VOICE_ID=nova
# OpenVoice self-hosted endpoint (example service URL)
OPENVOICE_BASE_URL=http://127.0.0.1:8001
# Optional if your OpenVoice wrapper uses a non-default path
OPENVOICE_TTS_PATH=/tts
# OpenVoice transport mode:
# auto   = try OPENVOICE_TTS_PATH first, then fallback to Gradio /api/predict
# direct = only call OPENVOICE_TTS_PATH
# gradio = call Gradio predict directly
OPENVOICE_API_MODE=auto
# Gradio adapter settings (used in gradio mode or auto fallback)
OPENVOICE_GRADIO_PREDICT_PATH=/api/predict
OPENVOICE_GRADIO_FN_INDEX=1
# Reference audio for voice cloning (path sent to OpenVoice service)
OPENVOICE_REFERENCE_AUDIO=resources/demo_speaker2.mp3
# Per-construct reference audio (Zen/Lin/Nova); unset = use OPENVOICE_REFERENCE_AUDIO
# OPENVOICE_REFERENCE_AUDIO_ZEN=resources/zen_speaker.mp3
# OPENVOICE_REFERENCE_AUDIO_LIN=resources/lin_speaker.mp3
# OPENVOICE_REFERENCE_AUDIO_NOVA=resources/nova_speaker.mp3
OPENVOICE_STYLE=default
# Optional bearer token if your OpenVoice service is protected
OPENVOICE_API_KEY=
# ElevenLabs fallback (only needed if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
