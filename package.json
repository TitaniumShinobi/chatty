{
  "name": "chatty",
  "version": "1.0.0",
  "type": "module",
  "description": "A next-generation AI workspace by LIFE Technology, designed for production environments.",
  "main": "index.js",
  "bin": {
    "chatty-cli": "./bin/chatty-cli"
  },
  "scripts": {
    "start": "NODE_ENV=production node server/server.js",
    "dev": "vite",
    "dev:strict": "VITE_STRICT_MODE=true vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "runtime:up": "bash scripts/keep-running.sh",
    "runtime:down": "bash scripts/runtime-down.sh",
    "server": "cd server && npm run dev",
    "server:cli": "cd server && npm run cli",
    "build": "vite build",
    "build:prod": "npm run build",
    "start:prod": "NODE_ENV=production node server/server.js",
    "prod:check": "npm run build && NODE_ENV=production ENABLE_SERVER_TIMING=true node server/server.js",
    "preview": "vite preview",
    "cli": "npx tsx src/cli/chatty-cli.ts",
    "terminal": "npx tsx src/cli/chatty-cli.ts",
    "probe:chatty-cli:live": "npx tsx server/scripts/runChattyCliConstructRollcall.ts",
    "probe:chatty-cli:orchestration": "npx tsx server/scripts/runChattyCliOrchestrationProof.ts",
    "probe:construct-source-evidence": "npx tsx server/scripts/runConstructSourceEvidenceProof.ts",
    "probe:five-construct:certification": "node server/scripts/runFiveConstructCertification.js",
    "probe:lin:canonical": "node server/scripts/runCanonicalProbeHarness.js",
    "probe:zenith:soak": "node server/scripts/runZenithLongRunSoakHarness.js",
    "probe:zenith:linear": "node server/scripts/runZenithLinearTranscriptLawGate.js",
    "probe:zenith:ordinary": "node server/scripts/runZenithOrdinaryVoiceGate.js",
    "lint": "eslint . --ext js,jsx,ts,tsx",
    "lint:fix": "eslint . --ext js,jsx,ts,tsx --fix",
    "test": "jest",
    "test:avatar-guard": "jest src/lib/avatarUrl.test.ts src/lib/addressBookAvatarPolicy.test.ts src/lib/addressBookAvatarSourceGuard.test.ts src/components/Sidebar.addressBookAvatar.test.tsx src/lib/threadUtils.test.ts --runInBand && npm --prefix server ci --silent && node --test server/tests/ais-avatar-route.test.js server/tests/vvault-conversation-route-contract.test.js server/tests/ai-manager-avatar-normalization.test.js",
    "ledger": "python3 scripts/append_ledger_entry.py",
    "project-map": "python3 scripts/project_map.py",
    "capsuleforge": "node scripts/capsuleforge-cli.js",
    "deploy": "./deploy/deploy.sh",
    "deploy:sync": "./deploy/deploy.sh --sync-only",
    "deploy:restart": "./deploy/deploy.sh --restart",
    "deploy:build": "./deploy/deploy.sh --build",
    "watchdog": "tsx watchdog/index.ts",
    "watchdog:check": "tsc --noEmit --project tsconfig.node.json",
    "watchdog:smoke": "bash scripts/watchdog-smoke.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "@types/react-window": "^1.8.8",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.16",
    "canvas": "^3.2.0",
    "clsx": "^2.0.0",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "glob": "^13.0.0",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.294.0",
    "openai": "^6.21.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.54",
    "pg": "^8.17.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-window": "^2.2.7",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.6",
    "tesseract.js": "^6.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.18",
    "web-vitals": "^5.1.0",
    "whisper-node": "^1.1.1",
    "yaml": "^2.8.3",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "better-sqlite3": "^12.4.6",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "ts-jest": "^29.4.1",
    "tsx": "^4.7.0"
  },
  "keywords": [
    "chat",
    "ai",
    "react",
    "typescript"
  ],
  "author": "LIFE Technology",
  "license": "MIT"
}
