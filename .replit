modules = ["nodejs-20", "python-3.12", "web", "bash", "postgresql-16"]
[agent]
expertMode = true
integrations = ["github:1.0.0", "javascript_openrouter_ai_integrations:2.0.0", "javascript_openai_ai_integrations:2.0.0"]

[nix]
channel = "stable-25_05"
packages = ["rsync", "unzip", "sqlite", "espeak"]
ignoredFiles = ["__pycache__/", "*.pyc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chatty App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MOCR Service"

[[workflows.workflow]]
name = "Chatty App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:full"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "MOCR Service"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd MOCR-Service && npx tsx src/api/server.ts"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5050
externalPort = 3002

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "NODE_ENV=production PORT=5000 npx tsx server/server.js & cd MOCR-Service && npx tsx src/api/server.ts"]
build = ["bash", "-c", "npm install --include=dev && npm run build && cd MOCR-Service && npm install"]

[userenv]

[userenv.development]
NODE_ENV = "development"
GOOGLE_CALLBACK = "https://9e87ef81-3206-41b7-ab62-5ac95372a8ad-00-1vnh2e2s81nle.riker.replit.dev/api/auth/google/callback"
CHATTY_TRANSCRIBE_URL = "http://localhost:5050/api/transcribe"

[userenv.shared]
VVAULT_API_BASE_URL = "https://vvault.thewreck.org"
AI_INTEGRATIONS_OPENAI_BASE_URL = "http://localhost:1106/modelfarm/openai"
AI_INTEGRATIONS_OPENAI_API_KEY = "_DUMMY_API_KEY_"
FXSHINOBI_API_BASE_URL = "https://e0a21a10-a007-4328-8b26-4be3a2eb056b-00-1u4qswx5jl1f0.janeway.replit.dev"
OPENROUTER_MODEL = "meta-llama/llama-3.3-70b-instruct"
OPENROUTER_API_KEY = "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"
ENABLE_CHROMADB = "false"
VITE_MOCR_SERVICE_URL = "http://localhost:3001"
MOCR_SERVICE_URL = "http://localhost:3001"

[userenv.production]
GOOGLE_CALLBACK = "https://chatty.thewreck.org/api/auth/google/callback"
NODE_ENV = "production"
INTERNAL_SERVICE_KEY = "chatty-internal-service-2026"
CHATTY_TRANSCRIBE_URL = "http://localhost:5000/api/transcribe"
